PORT=7777
ENV=development
LOG_LEVEL=info

# Shared secret between Next.js and AgentOS (must match web's AGENTOS_API_KEY)
AGENTOS_API_KEY=your-shared-secret-here

# LLM
ANTHROPIC_API_KEY=sk-ant-api03-...

# Live data
EXA_API_KEY=your-exa-api-key

# Database
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Usage limits (all have sensible defaults — uncomment to override)
# DAILY_RUN_LIMIT=50
# DAILY_INPUT_TOKEN_LIMIT=500000
# DAILY_OUTPUT_TOKEN_LIMIT=100000
# MAX_TOKENS_PER_RUN=50000
# RATE_LIMIT_PER_MIN=10
# GLOBAL_DAILY_RUN_BUDGET=5000
